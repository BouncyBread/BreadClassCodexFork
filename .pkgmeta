package-as: BreadClassCodexFork

# Libs/ is vendored from upstream and committed here as-is. Deliberately NOT
# declared under `externals`: the packager would otherwise fetch each library
# from its own repo at build time, which changes what actually ships and makes
# every build depend on those repos being reachable.
#
# No `license-output` either — the addon already carries jfstn's MIT LICENSE,
# and that directive would overwrite it with a generated file.

ignore:
  - .github
  - .gitignore
  - README.md
  - NOTICE
